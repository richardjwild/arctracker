{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "arctracker-ui",
  "version": "0.1.0",
  "identifier": "com.hmpo.arctracker-ui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Arctracker",
        "width": 1352,
        "height": 946,
        "visible": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "fullscreen": false,
        "maximized": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
