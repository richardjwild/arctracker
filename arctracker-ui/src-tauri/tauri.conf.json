{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arctracker",
  "version": "0.1.0",
  "identifier": "richardjwild.arctracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Arctracker",
        "width": 1337,
        "height": 946,
        "visible": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "fullscreen": false,
        "maximized": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["arctm"],
        "name": "Arctracker Module",
        "mimeType": "application/x-arctracker-module",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "richardjwild.arctracker.module",
          "conformsTo": ["public.data"]
        }
      },
      {
        "ext": ["musx"],
        "name": "Archimedes Tracker Module",
        "mimeType": "application/x-archimedes-tracker-module",
        "role": "Viewer",
        "rank": "Default"
      },
      {
        "ext": ["dskt"],
        "name": "Archimedes Desktop Tracker Module",
        "mimeType": "application/x-archimedes-desktop-tracker-module",
        "role": "Viewer",
        "rank": "Default"
      },
      {
        "ext": ["mod"],
        "name": "Amiga Protracker-compatible Module",
        "mimeType": "application/x-protracker-module",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
